{
  "name": "a2ui",
  "version": "0.0.0",
  "private": true,
  "description": "A2UI playground monorepo",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @a2ui/playground dev",
    "dev:server": "pnpm --filter @a2ui/playground-server dev",
    "build": "pnpm -r build",
    "dev:all": "pnpm --filter @a2ui/playground --filter @a2ui/playground-server --parallel dev"
  }
}
