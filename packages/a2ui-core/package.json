{
  "name": "@a2ui/core",
  "version": "0.0.1",
  "description": "A2UI core SDK: protocol parser, vnode mapping and render tree builder",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./mock/*": "./mock/*"
  },
  "files": [
    "dist",
    "mock"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "mocha test/**/*.test.ts",
    "test:parser": "mocha test/parser.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zustand": "^5.1.0"
  }
}
